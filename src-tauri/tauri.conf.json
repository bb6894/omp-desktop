{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP Desktop",
  "version": "0.1.4",
  "identifier": "dev.ohMyPi.desktop",
  "build": {
    "beforeDevCommand": "npm run next:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run next:build && npm run prepare:bundle",
    "frontendDist": "../renderer-next/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; frame-src 'none'; object-src 'none'",
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "OMP Desktop",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../artifacts/omp-desktop-host.exe": "omp-desktop-host.exe",
      "../artifacts/omp-windows-x64.exe": "omp-windows-x64.exe",
      "../artifacts/pi_natives.win32-x64-baseline.node": "pi_natives.win32-x64-baseline.node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
